# Development image: installs dependencies for Linux and runs `next dev`.
# Source code is bind-mounted by docker-compose.yml, so edits hot-reload.
FROM node:24-alpine

WORKDIR /app

# Install dependencies first so this layer is cached until package files change.
COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]
